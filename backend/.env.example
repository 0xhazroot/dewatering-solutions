# ==============================
# Dewatering Solutions — Environment Variables
# ==============================
# Copy this file to .env and fill in your actual values.

# Database (PostgreSQL / Supabase)
DB_HOST=your_database_host
DB_PORT=5432
DB_USER=your_database_user
DB_PASSWORD=your_secure_password
DB_NAME=your_database_name

# Authentication
JWT_SECRET=generate_a_strong_random_secret_here

# Server
PORT=3000
NODE_ENV=development

# AI Chatbot (Configure at least ONE provider below)
# Option 1: Groq API (Recommended - Free & Fast: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Option 2: Google AI Studio Gemini API (Free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# Option 3: OpenRouter API
OPENROUTER_API_KEY=sk-or-v1-your_key_here
